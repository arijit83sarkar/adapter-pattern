# EditorConfig keeps indentation and whitespace consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Java: 4 spaces
[*.java]
indent_size = 4

# Python: 4 spaces (PEP 8)
[*.py]
indent_size = 4

# TypeScript / JSON: 2 spaces
[*.{ts,js,json}]
indent_size = 2

# Markdown: don't trim trailing spaces (they can mean line breaks)
[*.md]
trim_trailing_whitespace = false
